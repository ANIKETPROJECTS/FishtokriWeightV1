# Copy to .env on the VPS, fill in the values, then run: chmod 600 .env
# Do not commit the real .env file.

# Required
MONGODB_URI=
SESSION_SECRET=

# Admin account configuration (set for a fresh production database)
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=
MASTER_ADMIN_RECOVERY_EMAIL=

# Optional integrations
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMTP_FROM=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
WABA_API_KEY=
WABA_PHONE_ID=

# Optional QZ Tray certificate/private key. Use quoted values with literal \n
# between lines if these are PEM files.
QZ_CERTIFICATE=""
QZ_PRIVATE_KEY=""

# Public URL used when returning uploaded-image links.
BASE_URL=https://admin.fishtokri.in
PUBLIC_APP_URL=
LOG_LEVEL=error
